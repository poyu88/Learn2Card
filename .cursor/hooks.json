{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "uv run python hooks/check_sensitive_prompt.py"
      }
    ],
    "beforeReadFile": [
      {
        "command": "uv run python hooks/check_sensitive_file.py"
      }
    ],
    "stop": [
      {
        "command": "uv run python hooks/send_line_notification.py"
      }
    ]
  }
}
